rules_version = '2';

// HQ Plus — Firestore client access is denied.
// Website submissions go through Cloud Functions, which validate and write
// with the Admin SDK. Admin SDK operations bypass these client security rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Lead documents are created by trusted Cloud Functions only.
    match /leads/{leadId} {
      allow read, write: if false;
    }

    // Demo gate documents are created by trusted Cloud Functions only.
    match /demo_leads/{leadId} {
      allow read, write: if false;
    }

    // Internal rate-limit counters are only accessed by the Admin SDK.
    match /rate_limits/{bucket} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
