---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pagina non trovata | HQ Plus"
  description="La pagina richiesta non è disponibile."
>
  <main id="main-content" class="min-h-screen grid place-items-center px-6 text-center">
    <div>
      <p class="font-mono text-sm text-[var(--accent)]">404</p>
      <h1 class="mt-3 text-4xl font-semibold text-[var(--text-primary)]">
        Pagina non trovata
      </h1>
      <p class="mt-4 text-[var(--text-secondary)]">
        Il contenuto potrebbe essere stato spostato.
      </p>
      <a
        class="button-primary mt-8 inline-flex rounded-md bg-[var(--accent)] px-5 py-3 font-medium text-[var(--accent-foreground)]"
        href="/"
      >
        Torna alla home
      </a>
    </div>
  </main>
</BaseLayout>
