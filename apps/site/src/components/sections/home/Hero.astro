---
import {
  ArrowDown,
  ArrowRight,
  Database,
  FileText,
  Mail,
  Play,
  Workflow,
} from "lucide-react";
import Logo from "@/components/brand/Logo.jsx";
---

<section
  id="top"
  class="cosmic-section cosmic-section--supernova hero-section relative flex min-h-[calc(100svh-4rem)] items-center overflow-hidden pt-24 pb-24 sm:pt-28"
  data-testid="hero-section"
>
  <div class="hero-horizon-fade" aria-hidden="true"></div>

  <div class="hero-shell relative z-10 mx-auto grid w-full max-w-7xl items-center gap-8 px-6 lg:grid-cols-[1.02fr_0.98fr] lg:gap-4 lg:px-8">
    <div class="hero-content mx-auto w-full max-w-2xl lg:mx-0">
      <div
        class="hero-badge mb-7 inline-flex items-center gap-2.5 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-elevated)]/80 px-4 py-1.5 font-mono text-[11px] tracking-[0.12em] text-[var(--text-secondary)] backdrop-blur-sm animate-fade-up"
        data-testid="hero-badge"
      >
        <span class="hero-status-dot h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
        <span>HQ+ &nbsp;·&nbsp; AI SYSTEM INTEGRATION</span>
      </div>

      <h1
        class="hero-headline text-center font-semibold text-[var(--text-primary)] animate-fade-up lg:text-left"
        style="animation-delay: 80ms"
        data-testid="hero-headline"
      >
        Sistemi diversi.<span class="brand-gradient-text">&nbsp;Un solo flusso.</span>
      </h1>

      <p
        class="hero-copy mx-auto mt-6 text-center text-lg leading-relaxed text-[var(--text-secondary)] animate-fade-up sm:text-xl lg:mx-0 lg:text-left"
        style="animation-delay: 180ms"
        data-testid="hero-subheadline"
      >
        HQ Plus collega software, dati e agenti AI nei processi reali dell’impresa. Meno
        passaggi manuali. Più lavoro che scorre.
      </p>

      <div
        class="hero-actions mt-9 flex flex-col justify-center gap-3 animate-fade-up sm:flex-row lg:justify-start"
        style="animation-delay: 280ms"
      >
        <a
          href="#contatti"
          class="button-primary cta-glow inline-flex items-center justify-center gap-2.5 rounded-md bg-[var(--accent)] px-6 py-3.5 text-[15px] font-medium text-[var(--accent-foreground)] transition-colors hover:bg-[var(--accent-hover)]"
          data-testid="hero-primary-cta"
        >
          Mappiamo un processo
          <ArrowRight size={18} strokeWidth={1.8} aria-hidden="true" />
        </a>
        <a
          href="#demo"
          class="button-secondary hero-secondary-cta inline-flex items-center justify-center gap-2.5 rounded-md border border-[var(--border-strong)] bg-[var(--bg-elevated)]/70 px-6 py-3.5 text-[15px] text-[var(--text-primary)] backdrop-blur-sm transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          data-testid="hero-secondary-cta"
        >
          <Play size={16} strokeWidth={1.8} aria-hidden="true" />
          Guarda come funziona
        </a>
      </div>

      <div
        class="hero-proofline mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 font-mono text-[11px] tracking-wide text-[var(--text-tertiary)] animate-fade-up lg:justify-start"
        style="animation-delay: 380ms"
        data-testid="hero-heritage-line"
      >
        <span>DAL GRUPPO HQ · 1999</span>
        <span class="hero-proof-separator" aria-hidden="true"></span>
        <span>40+ WORKFLOW AUTOMATIZZATI</span>
      </div>
    </div>

    <div
      class="integration-core relative mx-auto w-full max-w-[34rem]"
      data-integration-core
      role="img"
      aria-label="Mappa HQ Plus: email, documenti, CRM e gestionali collegati in un unico flusso intelligente."
    >
      <div class="integration-console">
        <div class="integration-console-head">
          <span class="integration-console-title">HQ+ / INTEGRATION CORE</span>
          <span class="integration-console-state">
            <span class="integration-live-dot"></span>
            SISTEMI CONNESSI
          </span>
        </div>

        <div class="integration-map" data-motion-stage>
          <svg
            class="integration-wiring"
            viewBox="0 0 520 520"
            fill="none"
            aria-hidden="true"
          >
            <circle
              class="integration-orbit integration-orbit--outer"
              cx="260"
              cy="260"
              r="218"
              data-motion-orbit="outer"
            />
            <ellipse
              class="integration-orbit integration-orbit--inner"
              cx="260"
              cy="260"
              rx="174"
              ry="118"
              transform="rotate(-32 260 260)"
              data-motion-orbit="inner"
            />
            <ellipse
              class="integration-orbit integration-orbit--latitude"
              cx="260"
              cy="260"
              rx="202"
              ry="78"
              transform="rotate(28 260 260)"
            />
            <path class="integration-link" d="M260 38V178" />
            <path class="integration-link" d="M482 260H342" />
            <path class="integration-link" d="M260 482V342" />
            <path class="integration-link" d="M38 260H178" />
            <path class="integration-data-flow" d="M260 38V178" data-motion-flow />
            <path class="integration-data-flow" d="M482 260H342" data-motion-flow />
            <path class="integration-data-flow" d="M260 482V342" data-motion-flow />
            <path class="integration-data-flow" d="M38 260H178" data-motion-flow />
            <circle class="integration-junction" cx="260" cy="179" r="3" />
            <circle class="integration-junction" cx="341" cy="260" r="3" />
            <circle class="integration-junction" cx="260" cy="341" r="3" />
            <circle class="integration-junction" cx="179" cy="260" r="3" />
          </svg>

          <span
            class="integration-signal integration-signal--one"
            data-motion-signal
          ></span>
          <span
            class="integration-signal integration-signal--two"
            data-motion-signal
          ></span>

          <div class="integration-node integration-node--documents">
            <span class="integration-node-icon">
              <FileText size={16} strokeWidth={1.7} />
            </span>
            <span class="integration-node-copy">
              <strong>Documenti</strong>
              <small>DATI STRUTTURATI</small>
            </span>
          </div>
          <div class="integration-node integration-node--crm">
            <span class="integration-node-icon">
              <Workflow size={16} strokeWidth={1.7} />
            </span>
            <span class="integration-node-copy">
              <strong>CRM</strong>
              <small>CLIENTI E ATTIVITÀ</small>
            </span>
          </div>
          <div class="integration-node integration-node--systems">
            <span class="integration-node-icon">
              <Database size={16} strokeWidth={1.7} />
            </span>
            <span class="integration-node-copy">
              <strong>Gestionali</strong>
              <small>SISTEMI ESISTENTI</small>
            </span>
          </div>
          <div class="integration-node integration-node--email">
            <span class="integration-node-icon">
              <Mail size={16} strokeWidth={1.7} />
            </span>
            <span class="integration-node-copy">
              <strong>Email</strong>
              <small>RICHIESTE IN INGRESSO</small>
            </span>
          </div>

          <div class="integration-hub">
            <div class="integration-hub-ring" data-motion-core-ring></div>
            <div class="integration-hub-center" data-motion-core>
              <Logo size="sm" className="integration-hub-logo" />
              <span class="integration-hub-label">
                INTELLIGENCE
                <br />
                LAYER
              </span>
              <span class="integration-hub-pulse"></span>
            </div>
          </div>
        </div>

        <div class="integration-console-foot">
          <span>01&nbsp; INPUT</span>
          <span class="integration-console-arrow" aria-hidden="true">
            →
          </span>
          <span>02&nbsp; INTEGRAZIONE</span>
          <span class="integration-console-arrow" aria-hidden="true">
            →
          </span>
          <span>03&nbsp; AZIONE</span>
        </div>
      </div>
    </div>
  </div>

  <a
    class="hero-scroll-cue"
    href="#origine"
    aria-label="Scorri alla sezione La nostra origine"
  >
    <span>SCOPRI IL METODO</span>
    <ArrowDown
      className="hero-scroll-icon"
      size={15}
      strokeWidth={1.8}
      aria-hidden="true"
    />
  </a>
</section>
