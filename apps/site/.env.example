# Only public browser configuration belongs here. Never put server secrets in
# PUBLIC_* variables: Astro includes them in the generated client bundle.

# Required for production App Check. Local Firebase emulators skip token checks.
PUBLIC_RECAPTCHA_SITE_KEY=

# Set only for the real production domain before enabling indexing.
PUBLIC_SITE_URL=
PUBLIC_ALLOW_INDEXING=false

# Optional endpoint overrides. Defaults use same-origin Firebase rewrites.
# Leave unset for the local Astro-to-Functions emulator proxy.
# PUBLIC_SUBMIT_LEAD_URL=
# PUBLIC_EXTRACT_URL=
# PUBLIC_SUGGEST_URL=
# PUBLIC_DEMO_LEAD_URL=
