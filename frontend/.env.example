# HQ | Flow — frontend env example.
# Copy to `.env` (or `.env.local`) and fill the values for your environment.
# All `REACT_APP_*` vars are inlined into the static bundle at build time —
# they are PUBLIC, do not put secrets here.

# Override the submitLead endpoint for local dev with the Functions emulator.
# Default: "/submitLead" (resolved via Hosting rewrite to Cloud Function).
# Example for emulator on the new region:
# REACT_APP_SUBMIT_LEAD_URL="http://127.0.0.1:5001/hq-flow-dev/europe-west8/submitLead"

# Override the extractDocument endpoint for local dev with the Functions emulator.
# REACT_APP_EXTRACT_URL="http://127.0.0.1:5001/hq-flow-dev/europe-west8/extractDocument"

# Override the submitDemoLead endpoint (soft email gate after 3 free demos).
# REACT_APP_DEMO_LEAD_URL="http://127.0.0.1:5001/hq-flow-dev/europe-west8/submitDemoLead"

# Firebase App Check — reCAPTCHA Enterprise site key (PUBLIC, safe to ship).
# Create the site key at:
#   https://console.cloud.google.com/security/recaptcha?project=hq-flow-dev
# Then register the App in Firebase Console → App Check → Apps:
#   https://console.firebase.google.com/project/hq-flow-dev/appcheck
# In dev, the browser console prints a debug token to whitelist locally.
REACT_APP_RECAPTCHA_SITE_KEY=
